// Managed by ~/.config/eww/scripts/theme.py: niri accents follow the wallpaper.
// Included last from config.kdl, so these colours override the ones set there.
layout {
    focus-ring {
        active-color "#ebbcbadd"
        active-gradient from="#ebbcbadd" to="#b6927bdd" angle=45 in="oklch shorter hue"
    }
    insert-hint {
        color "#ebbcba80"
    }
    tab-indicator {
        active-color "#ebbcba"
    }
}
recent-windows {
    highlight {
        active-color "#ebbcbaff"
    }
}
