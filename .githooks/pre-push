#!/usr/bin/env bash
# Refuse pushes that would publish secrets. Every commit being pushed is checked again, so commits
# made with --no-verify are caught too: files under private/, non-age files under secrets/, and
# keys or tokens (gitleaks with .gitleaks.toml when installed, the built-in patterns otherwise).
set -euo pipefail
# shellcheck source=.githooks/checks.sh
source "$(dirname "$0")/checks.sh"
top=$(git rev-parse --show-toplevel)
status=0
while read -r local_ref local_sha _ remote_sha; do
  [[ $local_sha =~ ^0+$ ]] && continue # deleting a remote ref
  if [[ $remote_sha =~ ^0+$ ]]; then
    range=("$local_sha" --not --remotes) # new branch: commits not on any remote yet
  else
    range=("$remote_sha..$local_sha")
  fi
  commits=$(git rev-list "${range[@]}")
  [[ -n $commits ]] || continue
  for c in $commits; do
    paths=$(git diff-tree --no-commit-id --name-only -r --root --diff-filter=ACMR "$c")
    [[ -z $paths ]] || check_paths pre-push "$paths" "$c:" || {
      echo "pre-push: (in commit ${c:0:12})" >&2
      status=1
    }
  done
  if command -v gitleaks >/dev/null; then
    if ! gitleaks git --no-banner --redact --log-level warn --config "$top/.gitleaks.toml" \
      --log-opts="${range[*]}" "$top" >&2; then
      echo "pre-push: gitleaks found possible secrets in $local_ref (above, redacted)" >&2
      status=1
    fi
  else
    hits=$(git log -p --text --format= "${range[@]}" -- "${NOT_ARCHIVES[@]}" | count_secret_lines)
    if ((hits > 0)); then
      echo "pre-push: $hits line(s) in $local_ref look like a private key or token (install gitleaks for details)" >&2
      status=1
    fi
  fi
done
exit $status
