#!/usr/bin/env bash
# Refuse commits that would publish secrets: files under private/, files under secrets/ that are
# not age-encrypted archives, and staged lines that look like a private key or an access token.
set -euo pipefail
# shellcheck source=.githooks/checks.sh
source "$(dirname "$0")/checks.sh"
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[[ -z $staged ]] && exit 0
check_paths pre-commit "$staged" ":" || exit 1
hits=$(git diff --cached --text -U0 --diff-filter=ACMR -- "${NOT_ARCHIVES[@]}" | count_secret_lines)
if ((hits > 0)); then
  echo "pre-commit: staged changes contain $hits line(s) that look like a private key or token:" >&2
  git diff --cached --text --name-only -G "$SECRET_PATTERN" --diff-filter=ACMR -- "${NOT_ARCHIVES[@]}" | sed 's/^/  /' >&2
  exit 1
fi
