cpio
jq
bc

# shell and terminal workflow
zsh
bash-completion
tmux
tree-sitter-cli  # nvim-treesitter parser builds
zoxide
fzf
fastfetch
starship
glow
cowsay
fortune-mod
nano

# modern coreutils replacements (bat installs as batcat, fd-find as fdfind)
ripgrep
fd-find
bat
eza
ncdu
plocate
